# SiliconFlow API（OpenAI 兼容接口，用于 LLM 双打分 + 中文标题 + TL;DR）
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3.2

# 联系邮箱（OpenAlex / Crossref / Unpaywall 都建议在 User-Agent 标识）
CONTACT_EMAIL=your_email@example.com

# 数据库路径
DB_PATH=./data/papers.db

# 增量更新配置（可选）
LOOKBACK_DAYS=14
LLM_SAFETY_LIMIT=500
